<div class="emotive-tooltip-card">
    <header class="et-header">{{name}}</header>
    {{#if stats.length}}
    <div class="et-stats">
        {{#each stats}}
        <span class="et-stat"><span class="et-label">{{label}}</span> <strong>{{value}}</strong></span>
        {{/each}}
    </div>
    {{/if}}
    {{#each blocks}}
    <section class="et-section">
        <div class="et-label">{{label}}</div>
        {{#if isBar}}
        <div class="et-bar">
            <div class="et-fill" style="width: {{pct}}%"></div>
            {{#if tempPct}}<div class="et-temp" style="width: {{tempPct}}%"></div>{{/if}}
            <span class="et-bar-text">{{text}}</span>
        </div>
        {{/if}}
        {{#if isIcons}}
        <div class="et-icons">
            {{#each items}}
            <span class="et-chip">
                <img src="{{img}}" alt="">
                <span>{{name}}</span>
                {{#if badge}}<span class="et-badge">{{badge}}</span>{{/if}}
            </span>
            {{/each}}
        </div>
        {{/if}}
        {{#if isList}}
        <ul class="et-list">
            {{#each items}}<li>{{this}}</li>{{/each}}
        </ul>
        {{/if}}
        {{#if isTable}}
        <table class="et-table">
            <tr>{{#each columns}}<th>{{this}}</th>{{/each}}</tr>
            {{#each rows}}<tr>{{#each this}}<td>{{this}}</td>{{/each}}</tr>{{/each}}
        </table>
        {{/if}}
    </section>
    {{/each}}
</div>
