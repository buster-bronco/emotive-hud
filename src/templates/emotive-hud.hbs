<div class="emotive-hud{{#if isMinimized}} minimized{{/if}}" data-dock="{{dockSide}}" style="--hud-bg-color: {{backgroundColor}}; --hud-bg-alpha: {{backgroundOpacity}};">
    <div class="hud-controls" title="Drag to move window">
        {{#if isGM}}
            <button class="control-button open-selector" title="Open Emotive HUD Actor Selector" type="button">
                <i class="fas fa-bars"></i>
            </button>
        {{/if}}
        <button class="control-button toggle-visibility" title="{{#if isMinimized}}Show{{else}}Hide{{/if}} Emotive HUD" type="button">
            <i class="{{toggleIcon}}"></i>
        </button>
    </div>
    <div class="portrait-container" style="--portrait-count: {{portraits.length}}; --grid-columns: {{columns}}; --floatingPortraitWidth: {{floatingPortraitWidth}}px">
        {{#each portraits}}
        <div class="portrait" data-actor-id="{{actorId}}" style="--portrait-ratio: {{emotivePortraitRatio}}">
            <img src="{{imgSrc}}" alt="{{name}}">
        </div>
        {{/each}}
        {{#if portraits.length}}
        <div class="resize-handle" data-corner="nw"></div>
        <div class="resize-handle" data-corner="ne"></div>
        <div class="resize-handle" data-corner="sw"></div>
        <div class="resize-handle" data-corner="se"></div>
        <div class="resize-handle" data-edge="n"></div>
        <div class="resize-handle" data-edge="s"></div>
        <div class="resize-handle" data-edge="e"></div>
        <div class="resize-handle" data-edge="w"></div>
        {{/if}}
    </div>
</div>